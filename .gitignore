# Variables de entorno — nunca subir al repositorio
.env
.env.*
.env.local
.env.production
.env.staging
# .env.example SI se versiona: documenta los build args de docker compose
# y no contiene secretos.
!.env.example

# Sistemas operativos
.DS_Store
Thumbs.db

# Editores
.vscode/settings.json
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Docker
docker-compose.override.yml

# Herramientas de agentes IA
# La configuración compartida (.claude/agents, commands, skills, output-styles)
# SÍ se versiona: es el contrato de equipo. Se excluye solo lo local o generado.
.claude/settings.local.json
.agents/settings.local.json

# Registro de skills autogenerado — contiene rutas absolutas de cada máquina.
# Se regenera con `gentle-ai skill-registry refresh`.
.atl/

# Caches de Python
__pycache__/
*.py[cod]

# Dependencias Node — frontend/.gitignore ya cubre frontend/node_modules;
# esta regla evita que un `npm install` corrido por error desde la raíz
# (o cachés como .vite) se cuele como untracked en git status.
node_modules/
